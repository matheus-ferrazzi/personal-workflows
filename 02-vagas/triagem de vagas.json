    {
      "parameters": {
        "jsCode": "// Puxando a memória global com o cifrão ($)\nconst staticData = $getWorkflowStaticData('global');\nconst vagas = staticData.vagasAprovadas || [];\n\n// Se o array estiver vazio, encerra o fluxo silenciosamente\nif (vagas.length === 0) {\n    return [];\n}\n\n// Junta todos os blocos em um e-mail só e limpa o buffer para a próxima execução\nconst corpoEmail = vagas.join('<br>');\nstaticData.vagasAprovadas = [];\n\nreturn [{json: { corpo_final: corpoEmail, total_vagas: vagas.length }}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -368
      ],
      "id": "b3e00b1c-ec2c-4e60-ac0f-082b056aac16",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// 1. Puxamos a vaga completa da catraca\nconst vaga = $('Loop Over Items').first().json;\nconst textoCru = $('Basic LLM Chain').first().json.text;\n\n// 2. Sanitização da IA\nconst inicio = textoCru.indexOf('{');\nconst fim = textoCru.lastIndexOf('}');\nconst jsonLimpo = textoCru.substring(inicio, fim + 1);\nconst ia = JSON.parse(jsonLimpo);\n\n// 3. Tratamento Inteligente de Localidade (Pega cidade ou estado, e verifica se é remoto)\nconst cidadeOuEstado = vaga.job_city || vaga.job_state || 'Local não especificado';\nconst flagRemoto = vaga.job_is_remote ? ' 🟢 (100% Remoto)' : '';\nconst localFinal = `${cidadeOuEstado}${flagRemoto} / ${vaga.job_country || 'BR'}`;\n\n// 4. Montamos o bloco HTML\nconst blocoHtml = `\n    <h2 style=\"color: #0056b3;\">🚀 Match: ${vaga.job_title}</h2>\n    <p><strong>🏢 Empresa:</strong> ${vaga.employer_name || 'Confidencial'}</p>\n    <p><strong>📍 Local:</strong> ${localFinal}</p>\n    <p><strong>🎯 Score:</strong> <span style=\"color: green; font-weight: bold;\">${ia.score}%</span></p>\n    <p><strong>Resumo:</strong> ${ia.summary}</p>\n    <a href=\"${vaga.job_apply_link}\" style=\"display: inline-block; margin-top: 10px; padding: 10px 20px; background-color: #0056b3; color: white; text-decoration: none; border-radius: 5px; font-weight: bold;\">Candidatar-se</a>\n    <hr style=\"border: 1px solid #eee; margin: 20px 0;\">\n`;\n\n// 5. Salva no Buffer Global\nconst staticData = $getWorkflowStaticData('global');\nstaticData.vagasAprovadas = staticData.vagasAprovadas || [];\nstaticData.vagasAprovadas.push(blocoHtml);\n\nreturn [{json: { status: \"Vaga salva no buffer com sucesso!\" }}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
