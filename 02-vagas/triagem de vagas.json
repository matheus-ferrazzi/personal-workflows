    {
      "parameters": {
        "jsCode": "// Puxa o backup de todas as vagas originais\nconst vagasOriginais = $('Split Out').all();\n\n// Restaura os dados completos apenas das vagas que passaram pelo banco\nreturn $input.all().map(item => {\n    const vagaCompleta = vagasOriginais.find(v => v.json.job_id === item.json.job_id);\n    return { json: vagaCompleta.json };\n});"
      },
