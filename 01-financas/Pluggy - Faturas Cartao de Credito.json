as = {\n  \"5eb1c057-af54-49f0-8f28-32b906f65cd7\": { dono: \"Ariane\", banco: \"Nubank\" },\n  \"e70a6d7d-1bf3-44c0-bd63-e8be7f915b19\": { dono: \"Ariane\", banco: \"Neon\" },\n  \"bf968b42-9cd7-47cd-aab1-77bbd4fe04fb\": { dono: \"Matheus\", banco: \"Nubank\" },\n  \"db9e68d5-ec6b-4da0-b4b7-b957ebe9f3e6\": { dono: \"Matheus\", banco: \"Santander\" },\n  \"77721586-135e-4d20-af6c-e85bde1046e1\": { dono: \"Matheus\", banco: \"Inter\" }\n};\n\nconst contas = $('Buscar Detalhes Conta').all();\n\nreturn $input.all().map((item, idx) => {\n  const bills      = item.json.results || [];\n  const account    = contas[idx].json;\n  const creditData = account.creditData || {};\n  const meta       = mapaContas[account.id] || { dono: 'Desconhecido', banco: 'Desconhecido' };\n\n  const sorted = bills.slice().sort((a,b) => (b.dueDate||'').localeCompare(a.dueDate||''));\n  const bill   = sorted[0] || {};\n\n  const usado = (creditData.creditLimit || 0) - (creditData.availableCreditLimit || 0);\n  const bal   = Math.abs(account.balance || 0);\n  const valor = bal > 0 ? bal : (usado > 0 ? Math.round(usado*100)/100 : 0);\n\n  const venc   = ((bill.dueDate || creditData.balanceDueDate || '') + '').slice(0,10) || null;\n  const fech   = ((bill.billClosingDate || creditData.balanceCloseDate || '') + '').slice(0,10) || null;\n  const minimo = bill.minimumPaymentAmount || creditData.minimumPayment || 0;\n\n  return { json: {\n    id_conta: account.id, banco: meta.banco, responsavel: meta.dono,\n    limite_total: creditData.creditLimit || 0, limite_disponivel: creditData.availableCreditLimit || 0,\n    valor_fatura_atual: valor, data_fechamento: fech, data_vencimento: venc,\n    pagamento_minimo: minimo, atualizado_em: new Date().toISOString()\n  }};\n});\n"},"id":"38fb0ec0-23e1-4fdb-926a-79007d71c2ff","name":"Transformar Dados Fatura","type":"n8n-nodes-base.code","typeVersion":2,"position":[992,-112]},{"parameters":{"operation":"upsert","schema":{"__rl":true,"value":"public","mode":"list","